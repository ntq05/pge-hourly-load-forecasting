```gitignore
# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# =========================
.env/
.venv/
env/
venv/
ENV/

# Conda environment created locally
./env/

# =========================
# Jupyter Notebook
# =========================
.ipynb_checkpoints/

# =========================
# Dataset
# =========================
Dataset/*.xlsx
Dataset/*.xls
Dataset/*.csv
Dataset/*.parquet

# =========================
# OS / IDE
# =========================
.DS_Store
Thumbs.db

.vscode/
.idea/

# =========================
# Python / tooling cache
# =========================
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =========================
# Temporary files
# =========================
*.tmp
*.temp
*.log

# =========================
# Secrets / local config
# =========================
.env
.env.*
!.env.example
```
